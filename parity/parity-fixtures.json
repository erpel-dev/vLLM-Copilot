      "expect": {}
    },
    {
      "input": "{}",
      "expect": {}
    },
    {
      "input": "{\"path\":\"foo.ts\"}",
      "expect": {
        "path": "foo.ts"
      }
    },
    {
      "input": "{\"a\": 1, \"b\": 2}",
      "expect": {
        "a": 1,
        "b": 2
      }
    },
    {
      "input": "{ path: 'foo.ts', nested: { arr: [1, 2,], } }",
      "expect": {
