            2
          ]
        }
      }
    },
    {
      "input": "{ cmd: 'ls', flag: True, none: None }",
      "expect": {
        "cmd": "ls",
        "flag": true,
        "none": null
      }
    },
    {
      "input": "{ 'msg': 'she said \"hi\"' }",
      "expect": {
        "msg": "she said \"hi\""
      }
    },
    {
      "input": "{\"a\": 1 \"b\": 2}",
      "expect": {
        "a": 1,
        "b": 2
      }
    },
    {
