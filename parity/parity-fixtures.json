      "expect": {
        "a": null,
        "b": 2
      }
    },
    {
      "input": "{\"text\":\"emoji \\ud83d\\ude00\",}",
      "expect": {
        "text": "emoji 😀"
      }
    },
    {
      "input": "{\"a\":1,,}",
      "expect": {
        "a": 1
      }
    },
    {
      "input": "{ , }",
      "expect": {}
    },
    {
      "input": "{\"k\":\"v\" ",
      "expect": {
        "k": "v"
      }
    },
    {
      "input": "{\"k\": \"v\",}",
      "expect": {
