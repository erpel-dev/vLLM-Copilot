    {
      "input": "{\"a\": {\"b\": {\"c\": [1, {\"d\": [true, {\"e\": \"f\"}]}]}}}",
      "expect": {
        "a": {
          "b": {
            "c": [
              1,
              {
                "d": [
                  true,
                  {
                    "e": "f"
                  }
                ]
              }
            ]
          }
